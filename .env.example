# --- Required ---
# Postgres connection string (docker-compose default shown)
DATABASE_URL=postgres://countertop:countertop@localhost:5432/countertop
# Secret for Auth.js session/JWT signing. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret
# Public URL of the app (used in magic links, alert links)
APP_URL=http://localhost:3000

# --- TCGAPIs (optional - offline fixture mode when unset) ---
# API key for https://api.tcgapis.com. NEVER commit a real key.
# Leave unset to run in offline dev mode with bundled fixtures.
TCGAPIS_API_KEY=
# Plan tier: hobby | business | unlimited (gates SKU pricing, live listings, sweeps)
TCGAPIS_TIER=hobby
# Requests-per-minute budget for the client rate limiter (match your plan)
TCGAPIS_RPM=300

# --- Email (optional - magic links + alert emails log to console when unset) ---
RESEND_API_KEY=
EMAIL_FROM=Countertop <notifications@example.com>

# --- Billing (P1 stub, keep disabled) ---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
